# Churny, runtime-generated Obsidian state.
.obsidian/workspace*.json
.obsidian/hotkeys.json

# Both plugins in this vault are injected at release time by obsidian-dev-toolkit: the freshly built plugin
# Under test, and the obsidian-dev-toolkit-owned `Demo Vault Helper`, which installs, configures and enables
# `CodeScript Toolkit` at runtime. Nothing plugin-related is committed.
#
# `CodeScript Toolkit` also lands here the first time you open this vault in Obsidian, which is where the
# Demo-vault button suite picks it up from.
.obsidian/plugins/*

# Written by the demo buttons in `01 Sample commands.md`; clicking through the walkthrough should not
# Leave the repository dirty.
Materials/01 Sample commands/Scratch note.md
